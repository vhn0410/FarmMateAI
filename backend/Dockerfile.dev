FROM python:3.14-slim

# Cài đặt uv từ image chính thức
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Thiết lập thư mục làm việc
WORKDIR /app

# Cài đặt các thư viện hệ thống cần thiết (cho psycopg2 và scikit-network C++ extensions)
RUN apt-get update && apt-get install -y libpq-dev gcc g++ python3-dev && rm -rf /var/lib/apt/lists/*

# Lưu ý: Không chạy uv sync ở đây để tránh bị ghi đè bởi anonymous volume.
# Việc cài đặt thư viện sẽ được thực hiện tự động lúc khởi động container (xem docker-compose.dev.yml).

# Thiết lập biến môi trường
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH="/app"

# Expose port 8000
EXPOSE 8000

# Lệnh khởi động mặc định (sẽ bị docker-compose command ghi đè)
CMD ["bash", "-c", "uv sync && uvicorn main:app --host 0.0.0.0 --port 8000 --reload"]
