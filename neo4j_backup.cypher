tac_cay_lua_1785658290)", chunk_id:"chunk_58"}}, {start: {id:"Khô Vằn"}, end: {id:"Lúa"}, properties:{file_id:"So_tay_ky_thuat_canh_tac_cay_lua_1785658290", file_ids:["So_tay_ky_thuat_canh_tac_cay_lua_1785658290"], description:"Khô vằn is another disease that poses a risk to Lúa crops.", source_file:"So_tay_ky_thuat_canh_tac_cay_lua_1785658290.md (ID: So_tay_ky_thuat_canh_tac_cay_lua_1785658290)", chunk_id:"chunk_58"}}, {start: {id:"Bạc Lá"}, end: {id:"Lúa"}, properties:{file_id:"So_tay_ky_thuat_canh_tac_cay_lua_1785658290", file_ids:["So_tay_ky_thuat_canh_tac_cay_lua_1785658290"], description:"Bạc lá is a disease that can severely impact Lúa production.", source_file:"So_tay_ky_thuat_canh_tac_cay_lua_1785658290.md (ID: So_tay_ky_thuat_canh_tac_cay_lua_1785658290)", chunk_id:"chunk_58"}}, {start: {id:"Ốc Bươu Vàng"}, end: {id:"Lúa"}, properties:{file_id:"So_tay_ky_thuat_canh_tac_cay_lua_1785658290", file_ids:["So_tay_ky_thuat_canh_tac_cay_lua_1785658290", "so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260"], description:"The presence of golden apple snails can negatively impact the seed requirement for rice.", source_file:"So_tay_ky_thuat_canh_tac_cay_lua_1785658290.md (ID: So_tay_ky_thuat_canh_tac_cay_lua_1785658290)", chunk_id:"chunk_63"}}, {start: {id:"Conogethes Punctiferalis"}, end: {id:"Sầu Riêng"}, properties:{file_id:"So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315", file_ids:["So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315"], description:"Conogethes punctiferalis larvae damage the flowers and fruits of Sầu riêng, leading to reduced yield and quality.", source_file:"So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315.md (ID: So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315)", chunk_id:"chunk_34"}}, {start: {id:"Amrasca sp."}, end: {id:"Sầu Riêng"}, properties:{file_id:"So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315", file_ids:["So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315"], description:"Amrasca sp. causes damage to Sầu riêng by sucking the sap from young leaves, leading to symptoms such as leaf burn and eventual leaf drop.", source_file:"So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315.md (ID: So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315)", chunk_id:"chunk_36"}}, {start: {id:"Allocaridara Malayensis"}, end: {id:"Sầu Riêng"}, properties:{file_id:"So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315", file_ids:["So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315"], description:"Allocaridara malayensis causes significant damage to Sầu riêng by feeding on young leaves, leading to leaf drop and affecting the plant's growth, flowering, and fruiting.", source_file:"So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315.md (ID: So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315)", chunk_id:"chunk_37"}}, {start: {id:"Bọ Trĩ"}, end: {id:"Sầu Riêng"}, properties:{file_id:"So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315", file_ids:["So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315"], description:"Bọ trĩ tấn công hoa và quả non của cây sầu riêng, gây hại nặng trong mùa nắng.", source_file:"So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315.md (ID: So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315)", chunk_id:"chunk_38"}}, {start: {id:"Planococcus sp."}, end: {id:"Sầu Riêng"}, properties:{file_id:"So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315", file_ids:["So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315"], description:"Rệp sáp *Planococcus* sp. tấn công vào quả sầu riêng, hút dịch vỏ quả, gây hại từ khi quả còn nhỏ cho đến lúc chín.", source_file:"So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315.md (ID: So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315)", chunk_id:"chunk_39"}}, {start: {id:"Nhện Đỏ"}, end: {id:"Sầu Riêng"}, properties:{file_id:"So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315", file_ids:["So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315"], description:"Nhện đỏ gây hại cho cây sầu riêng bằng cách cạp biểu bì mặt lá, tạo thành chấm trắng và tiết độc tố, dẫn đến lá vàng và cây còi cọc.", source_file:"So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315.md (ID: So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315)", chunk_id:"chunk_40"}}, {start: {id:"Batocera Rufomaculata"}, end: {id:"Sầu Riêng"}, properties:{file_id:"So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315", file_ids:["So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315"], description:"Sâu non của Batocera rufomaculata đục vào thân cây sầu riêng, gây hại nghiêm trọng đến sự tăng trưởng và có thể làm chết nhánh hoặc cả cây.", source_file:"So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315.md (ID: So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315)", chunk_id:"chunk_40"}}, {start: {id:"Xyleborus Similis"}, end: {id:"Sầu Riêng"}, properties:{file_id:"So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315", file_ids:["So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315"], description:"Mọt đục thân Xyleborus similis có thể gây hại cho cây sầu riêng bằng cách đục vào thân và cành.", source_file:"So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315.md (ID: So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315)", chunk_id:"chunk_40"}}, {start: {id:"Rhizoctonia"}, end: {id:"Sầu Riêng"}, properties:{file_id:"So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315", file_ids:["So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315"], description:"Bệnh cháy lá chết ngọn do nấm Rhizoctonia sp. gây ra, ảnh hưởng đến cây sầu riêng, làm cho lá non bị khô và rụng, chết ngọn, cành và nhánh nhỏ, ảnh hưởng rất lớn đến năng suất.", source_file:"So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315.md (ID: So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315)", chunk_id:"chunk_45"}}, {start: {id:"Bệnh Đốm Rong"}, end: {id:"Sầu Riêng"}, properties:{file_id:"So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315", file_ids:["So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315"], description:"Bệnh đốm rong tấn công trên lá và cành cây sầu riêng, làm giảm quang hợp và phát triển của cây.", source_file:"So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315.md (ID: So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315)", chunk_id:"chunk_47"}}, {start: {id:"Nấm Hồng"}, end: {id:"Cây Lớn Tuổi"}, properties:{file_id:"So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315", file_ids:["So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315"], description:"Nấm hồng disease primarily affects older trees, leading to symptoms such as leaf drop and branch death.", source_file:"So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315.md (ID: So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315)", chunk_id:"chunk_48"}}, {start: {id:"Nấm Hồng"}, end: {id:"Cành Cây Rậm Rạp"}, properties:{file_id:"So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315", file_ids:["So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315"], description:"Nấm hồng disease is commonly found on dense branches of trees, particularly at the second and third branching points.", source_file:"So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315.md (ID: So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315)", chunk_id:"chunk_48"}}] AS row
