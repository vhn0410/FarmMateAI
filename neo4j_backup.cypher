UNWIND [{start: {id:"Thời Tiết Bất Thuận"}, end: {id:"Cây Trồng"}, properties:{file_id:"So_tay_ky_thuat_canh_tac_cay_lua_1785658290", file_ids:["So_tay_ky_thuat_canh_tac_cay_lua_1785658290"], description:"Thời tiết bất thuận như khô hạn, rét sớm, hay nắng nóng bất thường có thể ảnh hưởng tiêu cực đến sự sinh trưởng của cây trồng.", source_file:"So_tay_ky_thuat_canh_tac_cay_lua_1785658290.md (ID: So_tay_ky_thuat_canh_tac_cay_lua_1785658290)", chunk_id:"chunk_21"}}, {start: {id:"Mùa Đông Ấm"}, end: {id:"Lúa"}, properties:{file_id:"So_tay_ky_thuat_canh_tac_cay_lua_1785658290", file_ids:["So_tay_ky_thuat_canh_tac_cay_lua_1785658290"], description:"Mùa đông ấm với số ngày có nhiệt độ nhỏ hơn 20°C dưới 60 ngày gây giảm năng suất lúa ở các tỉnh phía Bắc.", source_file:"So_tay_ky_thuat_canh_tac_cay_lua_1785658290.md (ID: So_tay_ky_thuat_canh_tac_cay_lua_1785658290)", chunk_id:"chunk_38"}}, {start: {id:"Rét Đậm"}, end: {id:"Lúa"}, properties:{file_id:"So_tay_ky_thuat_canh_tac_cay_lua_1785658290", file_ids:["So_tay_ky_thuat_canh_tac_cay_lua_1785658290"], description:"Rét đậm kéo dài trong tháng 1 và tháng 2 gây chết hàng loạt hoặc chết lỗ chỗ mạ và lúa mới cấy.", source_file:"So_tay_ky_thuat_canh_tac_cay_lua_1785658290.md (ID: So_tay_ky_thuat_canh_tac_cay_lua_1785658290)", chunk_id:"chunk_39"}}, {start: {id:"Rét Hại"}, end: {id:"Lúa"}, properties:{file_id:"So_tay_ky_thuat_canh_tac_cay_lua_1785658290", file_ids:["So_tay_ky_thuat_canh_tac_cay_lua_1785658290"], description:"Rét hại kéo dài trong tháng 1 và tháng 2 gây chết hàng loạt hoặc chết lỗ chỗ mạ và lúa mới cấy.", source_file:"So_tay_ky_thuat_canh_tac_cay_lua_1785658290.md (ID: So_tay_ky_thuat_canh_tac_cay_lua_1785658290)", chunk_id:"chunk_39"}}, {start: {id:"Nhiệt Độ Cao"}, end: {id:"Lúa"}, properties:{file_id:"So_tay_ky_thuat_canh_tac_cay_lua_1785658290", file_ids:["So_tay_ky_thuat_canh_tac_cay_lua_1785658290"], description:"Nhiệt độ quá cao (35 - 40°C) vào cuối tháng 5 và đầu tháng 6 không thuận lợi cho trỗ bông và chín.", source_file:"So_tay_ky_thuat_canh_tac_cay_lua_1785658290.md (ID: So_tay_ky_thuat_canh_tac_cay_lua_1785658290)", chunk_id:"chunk_39"}}, {start: {id:"Mưa Nhiều"}, end: {id:"Sầu Riêng Khổ Qua Xanh"}, properties:{file_id:"So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315", file_ids:["So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315"], description:"Nếu gặp thời tiết mưa nhiều, tỷ lệ ra hoa của cây sầu riêng Khổ qua xanh sẽ rất thấp.", source_file:"So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315.md (ID: So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315)", chunk_id:"chunk_7"}}, {start: {id:"Nhiệt Độ 30-35°C"}, end: {id:"Hạt Giống"}, properties:{file_id:"so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260", file_ids:["so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260"], description:"Nhiệt độ từ 30-35°C là điều kiện cần thiết để ủ hạt giống đạt yêu cầu.", source_file:"so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260.md (ID: so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260)", chunk_id:"chunk_24"}}, {start: {id:"Gió"}, end: {id:"Cây"}, properties:{file_id:"So_tay_ky_thuat_canh_tac_cay_buoi_1785661954", file_ids:["So_tay_ky_thuat_canh_tac_cay_buoi_1785661954"], description:"Tốc độ gió vừa phải giúp lưu thông không khí và điều hoà độ ẩm, từ đó hỗ trợ sự sinh trưởng của cây.", source_file:"So_tay_ky_thuat_canh_tac_cay_buoi_1785661954.md (ID: So_tay_ky_thuat_canh_tac_cay_buoi_1785661954)", chunk_id:"chunk_35"}}, {start: {id:"Mùa Mưa"}, end: {id:"Bưởi"}, properties:{file_id:"So_tay_ky_thuat_canh_tac_cay_buoi_1785661954", file_ids:["So_tay_ky_thuat_canh_tac_cay_buoi_1785661954"], description:"Trong mùa mưa, nếu không có mưa trong 7 ngày, cần tưới 60-70 lít nước/cây.", source_file:"So_tay_ky_thuat_canh_tac_cay_buoi_1785661954.md (ID: So_tay_ky_thuat_canh_tac_cay_buoi_1785661954)", chunk_id:"chunk_44"}}] AS row
