1785658290)", chunk_id:"chunk_70"}}, {start: {id:"Sầu Riêng Khổ Qua Xanh"}, end: {id:"Allocaridara Inalayensis"}, properties:{file_id:"So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315", file_ids:["So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315"], description:"Cây sầu riêng Khổ qua xanh thường bị rầy phấn Allocaridara inalayensis tấn công chích hút lá và lộc non.", source_file:"So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315.md (ID: So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315)", chunk_id:"chunk_7"}}, {start: {id:"Lúa"}, end: {id:"Sâu Bệnh Hại"}, properties:{file_id:"so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260", file_ids:["so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260"], description:"Lúa can be affected by various pests and diseases, including Sâu bệnh hại.", source_file:"so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260.md (ID: so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260)", chunk_id:"chunk_37"}}, {start: {id:"Nấm"}, end: {id:"Tơ Nấm"}, properties:{file_id:"so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260", file_ids:["so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260"], description:"Tơ nấm can negatively impact the growth of Nấm if humidity levels are not properly managed.", source_file:"so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260.md (ID: so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260)", chunk_id:"chunk_81"}}, {start: {id:"Nấm"}, end: {id:"Quả Thể"}, properties:{file_id:"so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260", file_ids:["so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260"], description:"Quả thể is the fruiting body of Nấm, which requires specific temperature and humidity conditions to develop.", source_file:"so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260.md (ID: so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260)", chunk_id:"chunk_81"}}, {start: {id:"Bưởi"}, end: {id:"Sâu Bệnh Hại"}, properties:{file_id:"So_tay_ky_thuat_canh_tac_cay_buoi_1785661954", file_ids:["So_tay_ky_thuat_canh_tac_cay_buoi_1785661954"], description:"Cây bưởi dễ bị ảnh hưởng bởi sâu bệnh hại, làm giảm năng suất.", source_file:"So_tay_ky_thuat_canh_tac_cay_buoi_1785661954.md (ID: So_tay_ky_thuat_canh_tac_cay_buoi_1785661954)", chunk_id:"chunk_11"}}] AS row
