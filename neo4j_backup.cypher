UNWIND [{start: {id:"SRI"}, end: {id:"Lúa"}, properties:{file_id:"So_tay_ky_thuat_canh_tac_cay_lua_1785658290", file_ids:["So_tay_ky_thuat_canh_tac_cay_lua_1785658290"], description:"Kỹ thuật SRI giúp tối ưu hóa việc tưới ướt khô xen kẽ cho lúa.", source_file:"So_tay_ky_thuat_canh_tac_cay_lua_1785658290.md (ID: So_tay_ky_thuat_canh_tac_cay_lua_1785658290)", chunk_id:"chunk_12"}}, {start: {id:"CĐML"}, end: {id:"Lúa"}, properties:{file_id:"So_tay_ky_thuat_canh_tac_cay_lua_1785658290", file_ids:["So_tay_ky_thuat_canh_tac_cay_lua_1785658290"], description:"Mô hình cánh đồng mẫu lớn (CĐML) giúp tăng hiệu quả sản xuất lúa.", source_file:"So_tay_ky_thuat_canh_tac_cay_lua_1785658290.md (ID: So_tay_ky_thuat_canh_tac_cay_lua_1785658290)", chunk_id:"chunk_13"}}, {start: {id:"IPM"}, end: {id:"Lúa"}, properties:{file_id:"So_tay_ky_thuat_canh_tac_cay_lua_1785658290", file_ids:["So_tay_ky_thuat_canh_tac_cay_lua_1785658290"], description:"The application of IPM improves the growth and yield of Lúa, leading to increased income.", source_file:"So_tay_ky_thuat_canh_tac_cay_lua_1785658290.md (ID: So_tay_ky_thuat_canh_tac_cay_lua_1785658290)", chunk_id:"chunk_20"}}, {start: {id:"Kiến Thức Bản Địa"}, end: {id:"Cây Trồng"}, properties:{file_id:"So_tay_ky_thuat_canh_tac_cay_lua_1785658290", file_ids:["So_tay_ky_thuat_canh_tac_cay_lua_1785658290"], description:"Kiến thức bản địa giúp nông dân điều chỉnh lịch gieo trồng và áp dụng các kỹ thuật phù hợp với điều kiện địa phương.", source_file:"So_tay_ky_thuat_canh_tac_cay_lua_1785658290.md (ID: So_tay_ky_thuat_canh_tac_cay_lua_1785658290)", chunk_id:"chunk_21"}}, {start: {id:"Giống Lúa Ngắn Ngày"}, end: {id:"Lúa"}, properties:{file_id:"So_tay_ky_thuat_canh_tac_cay_lua_1785658290", file_ids:["So_tay_ky_thuat_canh_tac_cay_lua_1785658290"], description:"Lựa chọn giống lúa có thời gian sinh trưởng ngắn giúp cây lúa trỗ bông an toàn.", source_file:"So_tay_ky_thuat_canh_tac_cay_lua_1785658290.md (ID: So_tay_ky_thuat_canh_tac_cay_lua_1785658290)", chunk_id:"chunk_41"}}, {start: {id:"Mạ Khay"}, end: {id:"Lúa"}, properties:{file_id:"So_tay_ky_thuat_canh_tac_cay_lua_1785658290", file_ids:["So_tay_ky_thuat_canh_tac_cay_lua_1785658290"], description:"Mạ khay improves the resilience of Lúa against adverse weather conditions.", source_file:"So_tay_ky_thuat_canh_tac_cay_lua_1785658290.md (ID: So_tay_ky_thuat_canh_tac_cay_lua_1785658290)", chunk_id:"chunk_48"}}, {start: {id:"Tưới Ướt - Khô Xen Kẽ"}, end: {id:"Lúa"}, properties:{file_id:"So_tay_ky_thuat_canh_tac_cay_lua_1785658290", file_ids:["So_tay_ky_thuat_canh_tac_cay_lua_1785658290"], description:"Kỹ thuật tưới ướt - khô xen kẽ giúp rễ lúa ăn sâu, chống đổ ngả và dễ thu hoạch.", source_file:"So_tay_ky_thuat_canh_tac_cay_lua_1785658290.md (ID: So_tay_ky_thuat_canh_tac_cay_lua_1785658290)", chunk_id:"chunk_56"}}, {start: {id:"Giá Thể Mạ Khay"}, end: {id:"Mạ"}, properties:{file_id:"So_tay_ky_thuat_canh_tac_cay_lua_1785658290", file_ids:["So_tay_ky_thuat_canh_tac_cay_lua_1785658290"], description:"Sử dụng giá thể mạ khay giúp duy trì độ pH ổn định từ 4,5 - 6,0, giúp cây mạ sinh trưởng khỏe và đồng đều.", source_file:"So_tay_ky_thuat_canh_tac_cay_lua_1785658290.md (ID: So_tay_ky_thuat_canh_tac_cay_lua_1785658290)", chunk_id:"chunk_74"}}, {start: {id:"Nông Nghiệp Thông Minh"}, end: {id:"Lúa"}, properties:{file_id:"So_tay_ky_thuat_canh_tac_cay_lua_1785658290", file_ids:["So_tay_ky_thuat_canh_tac_cay_lua_1785658290"], description:"Nông nghiệp thông minh giúp cải thiện năng suất và khả năng chống chịu của cây lúa trước biến đổi khí hậu.", source_file:"So_tay_ky_thuat_canh_tac_cay_lua_1785658290.md (ID: So_tay_ky_thuat_canh_tac_cay_lua_1785658290)", chunk_id:"chunk_76"}}, {start: {id:"Hệ Thống Tưới Tiết Kiệm"}, end: {id:"Sầu Riêng"}, properties:{file_id:"So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315", file_ids:["So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315"], description:"Sử dụng hệ thống tưới nước tiết kiệm giúp tưới cho cây sầu riêng trong thời gian xâm nhập mặn.", source_file:"So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315.md (ID: So_tay_ky_thuat_canh_tac_cay_sau_rieng_1785659315)", chunk_id:"chunk_25"}}, {start: {id:"Drone"}, end: {id:"Lúa"}, properties:{file_id:"so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260", file_ids:["so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260"], description:"Drones are used in the farming technique to enhance the efficiency of rice cultivation.", source_file:"so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260.md (ID: so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260)", chunk_id:"chunk_0"}}, {start: {id:"Kinh Tế Nông Nghiệp Tuần Hoàn Từ Rơm"}, end: {id:"Lúa"}, properties:{file_id:"so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260", file_ids:["so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260"], description:"The technique of agricultural circular economy from straw improves the quality and sustainability of rice production.", source_file:"so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260.md (ID: so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260)", chunk_id:"chunk_4"}}, {start: {id:"Sản Xuất Lúa Bền Vững"}, end: {id:"Lúa"}, properties:{file_id:"so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260", file_ids:["so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260"], description:"Sustainable rice production techniques improve the overall quality and environmental impact of rice farming.", source_file:"so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260.md (ID: so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260)", chunk_id:"chunk_4"}}, {start: {id:"San Phẳng Laser"}, end: {id:"Lúa"}, properties:{file_id:"so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260", file_ids:["so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260"], description:"San phẳng laser giúp cải thiện sự phát triển đồng đều của cây lúa bằng cách tạo ra mặt ruộng bằng phẳng, đảm bảo mực nước đều và giảm thiểu chênh lệch độ cao.", source_file:"so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260.md (ID: so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260)", chunk_id:"chunk_8"}}, {start: {id:"Máy Sạ Hàng Khí Động"}, end: {id:"Lúa"}, properties:{file_id:"so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260", file_ids:["so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260"], description:"Máy sạ hàng khí động giúp cây lúa hấp thụ phân bón tốt hơn, giảm thất thoát phân bón và tăng khả năng chịu hạn.", source_file:"so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260.md (ID: so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260)", chunk_id:"chunk_29"}}, {start: {id:"Máy Làm Cỏ"}, end: {id:"Lúa"}, properties:{file_id:"so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260", file_ids:["so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260"], description:"Using Máy làm cỏ improves the efficiency of weed management in Lúa cultivation.", source_file:"so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260.md (ID: so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260)", chunk_id:"chunk_39"}}, {start: {id:"Bảo Quản Lúa"}, end: {id:"Lúa"}, properties:{file_id:"so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260", file_ids:["so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260"], description:"Áp dụng công nghệ số trong quản lý bảo quản lúa giúp cải thiện chất lượng và hiệu quả bảo quản.", source_file:"so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260.md (ID: so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260)", chunk_id:"chunk_44"}}, {start: {id:"Xới Ruộng"}, end: {id:"Lúa"}, properties:{file_id:"so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260", file_ids:["so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260"], description:"Xới ruộng giúp cải thiện điều kiện đất cho sự phát triển của lúa.", source_file:"so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260.md (ID: so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260)", chunk_id:"chunk_51"}}, {start: {id:"Phủ Rơm"}, end: {id:"Rau"}, properties:{file_id:"so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260", file_ids:["so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260"], description:"Phủ rơm được áp dụng sau khi xuống giống cho các loại rau gieo hạt, giúp cải thiện điều kiện sinh trưởng.", source_file:"so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260.md (ID: so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260)", chunk_id:"chunk_59"}}, {start: {id:"Máy Đảo Trộn Luống Ủ"}, end: {id:"Lúa"}, properties:{file_id:"so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260", file_ids:["so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260"], description:"Sử dụng máy đảo trộn luống ủ giúp cải thiện chất lượng sản xuất lúa.", source_file:"so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260.md (ID: so-tay-huong-dan-quy-trinh-1-trieu-ha-dbscl-ngay-27-3-2024_1785660260)", chunk_id:"chunk_89"}}] AS row
